# Work computers: corporate identity, no signing keys by default.
[user]
	email = robert.altman@optum.com
[credential "https://github.com"]
	username = raltman2_uhg
[credential "https://github.com/raltman_uhgsand"]
	username = raltman2_uhgsand

# Personal repos: a clone whose remote matches uses the personal email,
# signing, and GitHub username from gitconfig.personal. One block per org or
# repo; these must stay after the defaults above. Requires git 2.36+.
[includeIf "hasconfig:remote.*.url:https://github.com/inquinity/**"]
	path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:https://github.com/Open-Lens/**"]
	path = ~/.gitconfig.personal
