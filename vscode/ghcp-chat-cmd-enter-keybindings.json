// ~/Library/Application Support/Code/User/keybindings.json
// These key bindings make Copilot chat use Cmd-Enter to submit, and Enter to insert a new line.
[
    // Disable the default `enter` submit behavior for GitHub Copilot chat
    {
        "key": "enter",
        "command": "-workbench.action.chat.submit",
        "when": "inChatInput && (chatInputHasText || chatInstructionsAttached)"
    },
    {
        "key": "cmd+enter",
        "command": "-workbench.action.chat.submitWithCodebase",
        "when": "inChatInput && (chatInputHasText || chatInstructionsAttached)"
    },
    // Setup new bindings for GitHub Copilot chat
    {
        "key": "cmd+enter",
        "command": "workbench.action.chat.submit",
        "when": "inChatInput && (chatInputHasText || chatInstructionsAttached)"
    },
    {
        "key": "cmd+shift+enter",
        "command": "workbench.action.chat.submitWithCodebase",
        "when": "inChatInput && (chatInputHasText || chatInstructionsAttached)"
    },
    {
        "key": "enter",
        "command": "editor.action.insertLineAfter",
        "when": "inChatInput"
    }
]